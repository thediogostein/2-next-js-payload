# Create a Postgres database (for example, Vercel Postgres / Neon) and add its connection string.
# Leave this unset locally to use the self-contained SQLite database.
DATABASE_URL=postgres://user:password@host/database?sslmode=require
# Generate a long random value, e.g. `openssl rand -base64 32`.
PAYLOAD_SECRET=replace-with-a-long-random-secret
# Vercel adds this after you create and connect a Blob store.
BLOB_READ_WRITE_TOKEN=
